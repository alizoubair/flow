# API Gateway base URL (no trailing slash)
REACT_APP_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod

# Cognito User Pool — get from AWS Console > Cognito > User Pools
REACT_APP_COGNITO_USER_POOL_ID=<region>_<pool-id>
REACT_APP_COGNITO_CLIENT_ID=<app-client-id>

# Cognito Hosted UI domain (no trailing slash)
# Format: https://<your-domain>.auth.<region>.amazoncognito.com
REACT_APP_COGNITO_DOMAIN=https://<your-domain>.auth.<region>.amazoncognito.com

# OAuth callback URL — must be registered in Cognito App Client settings
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
