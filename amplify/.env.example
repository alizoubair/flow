# HTTP API Gateway endpoint for pipeline operations
REACT_APP_API_URL=https://<your-api-id>.execute-api.<region>.amazonaws.com/dev

# WebSocket API endpoint for real-time pipeline execution
REACT_APP_WS_API_URL=wss://<your-ws-api-id>.execute-api.<region>.amazonaws.com/dev

# Cognito User Pool
REACT_APP_COGNITO_USER_POOL_ID=<region>_<pool-id>
REACT_APP_COGNITO_CLIENT_ID=<your-client-id>

# Cognito Hosted UI domain
REACT_APP_COGNITO_DOMAIN=https://<your-domain>.auth.<region>.amazoncognito.com

# OAuth callback URL — must be registered in Cognito App Client settings
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback

# AWS Region
REACT_APP_AWS_REGION=us-west-2
